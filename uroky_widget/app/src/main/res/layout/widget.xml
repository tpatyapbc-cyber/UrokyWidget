<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="#F6F7FB">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📚 УРОКИ" android:textSize="18sp" android:textStyle="bold" android:textColor="#202124" android:gravity="center" android:paddingBottom="8dp"/>
    <Button android:id="@+id/btnEnglish1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="🇬🇧 Англійська" android:textSize="14sp" android:textAllCaps="false" android:backgroundTint="#5B8DEF" android:textColor="#FFFFFF"/>
    <Button android:id="@+id/btnInfo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="💻 Інформатика" android:textSize="14sp" android:textAllCaps="false" android:backgroundTint="#35A66F" android:textColor="#FFFFFF"/>
    <Button android:id="@+id/btnMusic" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="🎵 Музичне мистецтво" android:textSize="14sp" android:textAllCaps="false" android:backgroundTint="#D88A3D" android:textColor="#FFFFFF"/>
    <Button android:id="@+id/btnOther" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="📚 Інші предмети" android:textSize="14sp" android:textAllCaps="false" android:backgroundTint="#C45A9A" android:textColor="#FFFFFF"/>
</LinearLayout>
